clear
clc
lujing=8;%选择参考轨迹
%% 将Carsim中的slx目录修改
%% i_CGMRES.slx
sim("i_CGMRES.slx")
vx=ans.vx.Data;
x=ans.x.Data;
y=ans.y.Data;
xref=ans.xref.Data(:,1);
yref=ans.yref.Data(:,1);
deltaf=ans.deltaf.Data;
time=ans.time.Data;ifnum=ans.ifnum.Data;
iter=ans.iter.Data;
%% P_CGMRES_fast.slx
sim("P_CGMRES_fast.slx")
vx2=ans.vx.Data;
x2=ans.x.Data;
y2=ans.y.Data;
deltaf2=ans.deltaf.Data;
time2=ans.time.Data;
ifnum2=ans.ifnum.Data;
iter2=ans.iter.Data;
%% P_CGMRES_slow.slx
sim("P_CGMRES_slow.slx")
vx3=ans.vx.Data;
x3=ans.x.Data;
y3=ans.y.Data;
deltaf3=ans.deltaf.Data;
time3=ans.time.Data;
ifnum3=ans.ifnum.Data;
iter3=ans.iter.Data;
%% MAIC_TD.slx
sim("MAIC_TD.slx")
vx4=ans.vx.Data;
time4=ans.vx.Time;
x4=ans.x.Data;
y4=ans.y.Data;
pitch4=ans.pitch.Data;
roll4=ans.roll.Data;
%% MAIC.slx
sim("MAIC.slx")
vx5=ans.vx.Data;
time5=ans.vx.Time;
x5=ans.x.Data;
y5=ans.y.Data;
pitch5=ans.pitch.Data;
roll5=ans.roll.Data;
%% MC.slx
sim("MC.slx")
vx6=ans.vx.Data;
time6=ans.vx.Time;
x6=ans.x.Data;
y6=ans.y.Data;
pitch6=ans.pitch.Data;
roll6=ans.roll.Data;


figure(1)
plot(x,y)
hold on
plot(x2,y2)
hold on
plot(x3,y3)
hold on
plot(xref,yref)
legend("i-C/GMRES","P-C/GMRES-fast","P-C/GMRES-slow")
xlabel("longitudinal position")
ylabel("lateral position")

figure(2)
plot(x,vx)
hold on
plot(x2,vx2)
hold on
plot(x3,vx3)
legend("i-C/GMRES","P-C/GMRES-fast","P-C/GMRES-slow")
xlabel("longitudinal position")
ylabel("longitudinal velocity")

figure(3)
plot(x,deltaf)
hold on
plot(x2,deltaf2)
hold on
plot(x3,deltaf3)
legend("i-C/GMRES","P-C/GMRES-fast","P-C/GMRES-slow")
xlabel("longitudinal position")
ylabel("front wheel angle")

figure(4)
plot(x,time)
hold on
plot(x2,time2)
hold on
plot(x3,time3)
legend("i-C/GMRES","P-C/GMRES-fast","P-C/GMRES-slow")
xlabel("longitudinal position")
ylabel("calculation time")

figure(5)
plot(x,iter)
hold on
plot(x2,iter2)
hold on
plot(x3,iter3)
legend("i-C/GMRES","P-C/GMRES-fast","P-C/GMRES-slow")
xlabel("longitudinal position")
ylabel("iterative number")

figure(6)
plot(x,ifnum)
xlabel("longitudinal position")
ylabel("condtition number")
legend("i-C/GMRES")


figure(7)
plot(x2,ifnum2)
xlabel("longitudinal position")
ylabel("condtition number")
legend("P-C/GMRES-fast")


figure(8)
plot(x3,ifnum3)
xlabel("longitudinal position")
ylabel("condtition number")
legend("P-C/GMRES-slow")

figure(9)
plot(x4,y4)
hold on
plot(x5,y5)
hold on
plot(x6,y6)
hold on
plot(xref,yref)
legend("MAIC-TD","MAIC","MC")
xlabel("longitudinal position")
ylabel("lateral position")

figure(10)
plot(time4,vx4)
hold on
plot(time5,vx5)
hold on
plot(time6,vx6)
legend("MAIC-TD","MAIC","MC")
xlabel("time")
ylabel("longitudinal velocity")

figure(11)
plot(time4,pitch4)
hold on
plot(time5,pitch5)
hold on
plot(time6,pitch6)
legend("MAIC-TD","MAIC","MC")
xlabel("time")
ylabel("pitch")


figure(12)
plot(time4,roll4)
hold on
plot(time5,roll5)
hold on
plot(time6,roll6)
legend("MAIC-TD","MAIC","MC")
xlabel("time")
ylabel("roll")

